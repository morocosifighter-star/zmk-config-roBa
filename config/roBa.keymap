/*
 * roBa keymap  ---  Keyball39 (takashicompany2025 / miniZone + Remap 最新) 完全移植
 *
 * Layer 番号は Keyball39 の Layer 0-6 をそのまま維持
 *   L0 BASE   : 常時
 *   L1 WIN    : 左親指2（Win）長押し
 *   L2 SYMBOL : 左親指5（BS）長押し
 *   L3 NUM    : 左親指6（Space）長押し
 *   L4 NAV    : 右親指1（無変換）長押し
 *   L5 FUNC   : 右親指2（変換）長押し
 *   L6 MOUSE  : トラックボールを動かすと自動で有効
 *
 * 行の並びは roBa の matrix transform 準拠（1レイヤー43個）
 *   1行目: 左5 + 右5
 *   2行目: 左5 + [左内側=予備] + [右内側=予備] + 右5
 *   3行目: 左5 + [左内側=予備] + [右内側=予備] + 右5
 *   4行目: 左親指6 + 右親指2 + 右最外下1
 *
 * 空けてある予備ポート（roBa 独自機能を後から足せる）
 *   左内側 2段目 / 左内側 3段目 / 右内側 2段目 / 右内側 3段目 / エンコーダ
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* トラックボール: miniZone と同じ「動いたら L6」 */
&trackball {
    automouse-layer = <6>;
};

/* Keyball の TAPPING_TERM 200 に合わせる */
&mt { flavor = "balanced"; quick-tap-ms = <0>; tapping-term-ms = <200>; };
&lt { flavor = "balanced"; quick-tap-ms = <0>; tapping-term-ms = <200>; };

/ {
    macros {
        /* Remap Macro 0 （1文字目が小文字なら LS() を外す） */
        macro_0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(W) &kp N1 &kp T &kp Y &kp Y &kp T &kp N6 &kp N5 &kp N6 &kp N5>;
        };
        /* Remap Macro 1 （同上） */
        macro_1: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(A) &kp MINUS &kp Z &kp I &kp P &kp N0 &kp N8 &kp N2 &kp N2>;
        };
        /* Remap Macro 2 （同上） */
        macro_2: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(S) &kp Y &kp S &kp T &kp E &kp M &kp N3 &kp N0 &kp N2 &kp N2>;
        };
    };

    behaviors {
        /* QMK の TT(n) 相当: 長押し=一時有効 / タップ=トグル */
        tt_2: tt_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 2>, <&tog 2>;
        };
        tt_3: tt_3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 3>, <&tog 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ===================== BASE ===================== */
        base {
            display-name = "BASE";
            bindings = <
    &kp Q              &kp W              &kp E              &kp R              &kp T              &kp Y              &kp U              &kp I              &kp O              &kp P
    &kp A              &kp S              &kp D              &kp F              &kp G              &trans             &trans             &kp H              &kp J              &kp K              &kp L              &kp ENTER
    &kp Z              &kp X              &kp C              &kp V              &kp B              &trans             &trans             &kp N              &kp M              &kp COMMA          &kp DOT            &kp MINUS
    &kp LCTRL          &lt 1 LGUI         &kp LALT           &kp LSHFT          &lt 2 BSPC         &lt 3 SPACE        &lt 4 INT_MUHENKAN  &lt 5 INT_HENKAN   &kp INS
            >;

        /* ===================== L1_WIN ===================== */
        l1_win {
            display-name = "L1_WIN";
            bindings = <
    &macro_0           &macro_1           &macro_2           &kp LA(F4)         &kp LC(LA(DEL))    &trans             &trans             &trans             &trans             &trans
    &kp LGUI           &kp LG(E)          &kp LG(R)          &trans             &kp LG(LC(LS(B)))  &trans             &trans             &trans             &trans             &kp LG(L)          &trans             &trans
    &trans             &kp LG(X)          &trans             &trans             &kp LC(LA(PAUSE_BREAK))  &trans             &kp LCAPS          &kp LG(M)          &trans             &trans             &trans             &trans
    &trans             &trans             &trans             &trans             &trans             &kp LG(SPACE)      &trans             &trans             &trans
            >;

        /* ===================== L2_SYMBOL ===================== */
        l2_symbol {
            display-name = "L2_SYMBOL";
            bindings = <
    &kp LS(N1)         &kp LS(N2)         &kp LS(N3)         &kp LS(N4)         &kp LS(N5)         &kp LS(N6)         &kp LS(N7)         &kp LS(N8)         &kp LS(N9)         &kp LS(MINUS)
    &kp EQUAL          &kp PLUS           &kp LEFT_BRACE     &kp RIGHT_BRACE    &kp PIPE           &trans             &trans             &kp RIGHT_BRACKET  &kp BACKSLASH      &kp SEMICOLON      &kp SQT            &kp LEFT_BRACKET
    &kp LS(INT_YEN)    &trans             &trans             &kp LC(SEMICOLON)  &kp LC(SQT)        &trans             &trans             &kp LS(COMMA)      &kp LS(DOT)        &kp LS(SLASH)      &kp LS(INT_RO)     &kp INT_RO
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans
            >;

        /* ===================== L3_NUM ===================== */
        l3_num {
            display-name = "L3_NUM";
            bindings = <
    &kp ESC            &trans             &trans             &kp LA(F11)        &kp GRAVE          &kp N7             &kp N8             &kp N9             &kp MINUS          &kp SLASH
    &kp TAB            &trans             &trans             &kp LALT           &kp LSHFT          &trans             &trans             &kp N4             &kp N5             &kp N6             &kp KP_PLUS        &kp KP_ENTER
    &kp LS(TAB)        &trans             &trans             &trans             &kp LCTRL          &trans             &trans             &kp N1             &kp N2             &kp N3             &kp DOT            &kp COMMA
    &trans             &trans             &trans             &kp LS(SPACE)      &trans             &trans             &trans             &kp N0             &kp KP_MULTIPLY
            >;

        /* ===================== L4_NAV ===================== */
        l4_nav {
            display-name = "L4_NAV";
            bindings = <
    &trans             &trans             &trans             &trans             &trans             &kp BSPC           &kp DEL            &kp INS            &kp HOME           &kp END
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LSHFT          &kp UP_ARROW       &kp LCTRL          &kp PG_UP          &kp ENTER
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LEFT_ARROW     &kp DOWN_ARROW     &kp RIGHT_ARROW    &kp PG_DN          &kp LS(LCTRL)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &tt_3              &trans
            >;

        /* ===================== L5_FUNC ===================== */
        l5_func {
            display-name = "L5_FUNC";
            bindings = <
    &kp F1             &kp F2             &kp F3             &kp F4             &kp F5             &trans             &trans             &trans             &kp LC(PG_UP)      &kp LC(PG_DN)
    &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &trans             &trans             &trans             &trans             &trans             &trans             &trans
    &kp F11            &kp F12            &kp LC(PAUSE_BREAK)  &kp PAUSE_BREAK    &kp PSCRN          &trans             &trans             &trans             &trans             &trans             &trans             &trans
    &trans             &trans             &trans             &trans             &trans             &trans             &tt_2              &trans             &trans
            >;

        /* ===================== L6_MOUSE ===================== */
        l6_mouse {
            display-name = "L6_MOUSE";
            bindings = <
    &trans             &trans             &trans             &trans             &trans             &kp LC(M)          &kp LC(W)          &kp LG(J)          &kp LC(LS(TAB))    &kp LC(TAB)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LG(Y)          &mkp MB1           &mkp MB3           &mkp MB2           &kp ENTER
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LC(LS(N))      &kp LG(C)          &kp LC(C)          &kp LC(V)          &kp LG(E)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LC(SLASH)
            >;
        };
    };
};
