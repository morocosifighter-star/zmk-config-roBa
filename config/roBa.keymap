/*
 * roBa keymap  ---  Keyball39 (takashicompany2025 / miniZone + Remap 最新) 移植
 *
 * L0 BASE / L1 MOUSE(自動・最下位) / L2 WIN / L3 SYMBOL / L4 NUM / L5 NAV / L6 FUNC
 *
 * 重要: MOUSE は最下位の層なので、上位層の &trans は MOUSE に落ちてしまう。
 *       それを防ぐため、MOUSE で何か定義している16箇所は上位層にも明示的に書いてある
 *       （Keyball の「▽はレイヤ0に落ちる」と同じ結果になる）。
 *
 * 余りポート: 左内側上 BT_SEL0(長押し) / 左内側下 BT_SEL1(長押し) / 右内側上 長押し=BT_SEL2 / タップ=USB⇔BLE / 右内側下 BT_CLR_ALL(長押し)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&trackball {
    automouse-layer = <1>;
    scroll-layers   = <7>;   /* L7 SCROLL が有効な間はトラックボール＝スクロール */
};

&mt { flavor = "balanced"; quick-tap-ms = <0>;   tapping-term-ms = <200>; };
/* レイヤータップ（Space/BS/LGUI）: 他のキーを押した瞬間にレイヤー確定＝Keyball と同じ体感速度
   quick-tap-ms=200 は「同じキーを素早く2回押して2回目を保持＝連打」用 */
/* 押した瞬間にレイヤーを有効化（他のキーの到着を待たない）
   タップ（他キーなしで離す）なら最後にスペース/BSを送る */
/* hold-while-undecided: 押した瞬間からレイヤー有効（右手キーの到着を待たない）
   IMEマクロが &to 0 ではなく &loff 1（MOUSE層だけ解除）なので、押しっぱなしの層は壊れない */
&lt { flavor = "hold-preferred"; quick-tap-ms = <200>; tapping-term-ms = <200>; hold-while-undecided; };

/ {
    macros {
        /* BT プロファイル選択（hold-tap から呼ぶため引数なしのマクロにしておく） */
        sel0: sel0 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&bt BT_SEL_CMD 0>; };
        sel1: sel1 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&bt BT_SEL_CMD 1>; };
        sel2: sel2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&bt BT_SEL_CMD 2>; };
        clrall: clrall { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&bt BT_CLR_ALL_CMD 0>; };

        macro_0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(W) &kp N1 &kp T &kp Y &kp Y &kp T &kp N6 &kp N5 &kp N6 &kp N5>;
        };
        macro_1: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(A) &kp MINUS &kp Z &kp I &kp P &kp N0 &kp N8 &kp N2 &kp N2>;
        };
        macro_2: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(S) &kp Y &kp S &kp T &kp E &kp M &kp N3 &kp N0 &kp N2 &kp N2>;
        };
        mwy: mwy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LGUI &macro_tap &kp Y &macro_release &kp LGUI>;
        };
        mwj: mwj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LGUI &macro_tap &kp J &macro_release &kp LGUI>;
        };
        mwc: mwc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LGUI &macro_tap &kp C &macro_release &kp LGUI>;
        };
        m_mu: m_mu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &loff 1 &macro_tap &kp INT_MUHENKAN>;
        };
        m_hn: m_hn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &loff 1 &macro_tap &kp INT_HENKAN>;
        };
    };

    behaviors {
        tt: tt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&mo>, <&tog>;
        };
        ltm: ltm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&m_mu>;
        };
        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&m_hn>;
        };
        /* BT: 長押しで発動（タップ無効）
           hold-tap の bindings は「引数なしの phandle」しか置けないため、
           プロファイル番号はマクロ側に埋め込んでいる */
        /* 中クリックキー: 押している間はスクロール / タップで中クリック */
        scrl: scrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            hold-while-undecided;
            bindings = <&mo>, <&mkp>;
        };

        /* 押した瞬間にレイヤーON / 単独タップなら離した時にキー送出
           （ZMK の hold-tap は未確定を1個しか持てないため、無変換を押したまま
             スペースを押すとスペース側が反応しない。それを避ける専用ビヘイビア） */
        lht: lht {
            compatible = "zmk,behavior-lht";
            #binding-cells = <2>;
        };

        /* 指定レイヤーだけを解除する（&to 0 と違い、押しっぱなしの層を巻き込まない） */
        loff: loff {
            compatible = "zmk,behavior-layer-off";
            #binding-cells = <1>;
        };

        bt0: bt0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&sel0>, <&trans>;
        };
        bt1: bt1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&sel1>, <&trans>;
        };
        bt2o: bt2o {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&sel2>, <&out>;
        };
        bclr: bclr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&clrall>, <&trans>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
    &kp Q              &kp W              &kp E              &kp R              &kp T              &kp Y              &kp U              &kp I              &kp O              &kp P
    &kp A              &kp S              &kp D              &kp F              &kp G              &bt0 0 0  &bt2o 0 0  &kp H              &kp J              &kp K              &kp L              &kp ENTER
    &kp Z              &kp X              &kp C              &kp V              &kp B              &bt1 0 0  &bclr 0 0  &kp N              &kp M              &kp COMMA          &kp DOT            &kp MINUS
    &kp LCTRL          &lht 2 LGUI         &kp LALT           &kp LSHFT          &lht 3 BSPC         &lht 4 SPACE        &ltm 5 0           &lth 6 0           &kp INS
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
    &trans             &trans             &trans             &trans             &trans             &kp LC(M)          &kp LC(W)          &mwj               &kp LC(LS(TAB))    &kp LC(TAB)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &mwy               &mkp               MB1                &scrl              7                  MB3                &mkp               MB2                &kp                ENTER            
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LC(LS(N))      &mwc               &kp LC(C)          &kp LC(V)          &kp LG(E)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LC(SLASH)
            >;
        };

        win {
            display-name = "WIN";
            bindings = <
    &macro_0           &macro_1           &macro_2           &kp LA(F4)         &kp LC(LA(DEL))    &kp Y              &kp U              &kp I              &kp O              &kp P
    &kp LGUI           &kp LG(E)          &kp LG(R)          &trans             &kp LG(LC(LS(B)))  &trans             &trans             &kp H              &kp J              &kp K              &kp LG(L)          &kp ENTER
    &trans             &kp LG(X)          &trans             &trans             &kp LC(LA(PAUSE_BREAK))  &trans             &trans             &kp LCAPS          &kp LG(M)          &kp COMMA          &kp DOT            &kp MINUS
    &trans             &trans             &trans             &trans             &trans             &kp LG(SPACE)      &trans             &trans             &kp INS
            >;
        };

        symbol {
            display-name = "SYMBOL";
            bindings = <
    &kp LS(N1)         &kp LS(N2)         &kp LS(N3)         &kp LS(N4)         &kp LS(N5)         &kp LS(N6)         &kp LS(N7)         &kp LS(N8)         &kp LS(N9)         &kp LS(MINUS)
    &kp EQUAL          &kp PLUS           &kp LEFT_BRACE     &kp RIGHT_BRACE    &kp PIPE           &trans             &trans             &kp RIGHT_BRACKET  &kp BACKSLASH      &kp SEMICOLON      &kp SQT            &kp LEFT_BRACKET
    &kp LS(INT_YEN)    &trans             &trans             &kp LC(SEMICOLON)  &kp LC(SQT)        &trans             &trans             &kp LS(COMMA)      &kp LS(DOT)        &kp LS(SLASH)      &kp LS(INT_RO)     &kp INT_RO
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp SLASH
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
    &kp ESC            &trans             &trans             &kp LA(F11)        &kp GRAVE          &kp N7             &kp N8             &kp N9             &kp MINUS          &kp SLASH
    &kp TAB            &trans             &trans             &kp LALT           &kp LSHFT          &trans             &trans             &kp N4             &kp N5             &kp N6             &kp KP_PLUS        &kp KP_ENTER
    &kp LS(TAB)        &trans             &trans             &trans             &kp LCTRL          &trans             &trans             &kp N1             &kp N2             &kp N3             &kp DOT            &kp COMMA
    &trans             &trans             &trans             &kp LS(SPACE)      &trans             &trans             &trans             &kp N0             &kp KP_MULTIPLY
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
    &trans             &trans             &trans             &trans             &trans             &kp BSPC           &kp DEL            &kp INS            &kp HOME           &kp END
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LSHFT          &kp UP_ARROW       &kp LCTRL          &kp PG_UP          &kp ENTER
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LEFT_ARROW     &kp DOWN_ARROW     &kp RIGHT_ARROW    &kp PG_DN          &kp LS(LCTRL)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &tt 4 4            &kp INS
            >;
        };

        func {
            display-name = "FUNC";
            bindings = <
    &kp F1             &kp F2             &kp F3             &kp F4             &kp F5             &kp Y              &kp U              &kp I              &kp LC(PG_UP)      &kp LC(PG_DN)
    &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &trans             &trans             &kp H              &kp J              &kp K              &kp L              &kp ENTER
    &kp F11            &kp F12            &kp LC(PAUSE_BREAK)  &kp PAUSE_BREAK    &kp PSCRN          &trans             &trans             &kp N              &kp M              &kp COMMA          &kp DOT            &kp MINUS
    &trans             &trans             &trans             &trans             &trans             &trans             &tt 3 3            &trans             &kp INS
            >;
        };

        scroll {
            display-name = "SCROLL";
            bindings = <
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans           
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans           
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans           
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans           
            >;
        };
    };
};
