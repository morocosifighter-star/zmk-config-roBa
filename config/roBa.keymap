/*
 * roBa keymap  ---  Keyball39 (takashicompany2025 / miniZone + Remap 最新) 移植
 *
 * L0 BASE / L1 MOUSE(自動・最下位) / L2 WIN / L3 SYMBOL / L4 NUM / L5 NAV / L6 FUNC
 *
 * 重要: MOUSE は最下位の層なので、上位層の &trans は MOUSE に落ちてしまう。
 *       それを防ぐため、MOUSE で何か定義している16箇所は上位層にも明示的に書いてある
 *       （Keyball の「▽はレイヤ0に落ちる」と同じ結果になる）。
 *
 * 余りポート: 左内側上 BT_SEL0(長押し) / 左内側下 BT_SEL1(長押し) / 右内側上 OUT_TOG(USB⇔BLE) / 右内側下 BT_CLR_ALL(長押し)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&trackball {
    automouse-layer = <1>;
};

&mt { flavor = "balanced"; quick-tap-ms = <0>;   tapping-term-ms = <200>; };
&lt { flavor = "balanced"; quick-tap-ms = <200>; tapping-term-ms = <200>; };

/ {
    macros {
        macro_0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(W) &kp N1 &kp T &kp Y &kp Y &kp T &kp N6 &kp N5 &kp N6 &kp N5>;
        };
        macro_1: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(A) &kp MINUS &kp Z &kp I &kp P &kp N0 &kp N8 &kp N2 &kp N2>;
        };
        macro_2: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(S) &kp Y &kp S &kp T &kp E &kp M &kp N3 &kp N0 &kp N2 &kp N2>;
        };
        mwy: mwy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LGUI &macro_tap &kp Y &macro_release &kp LGUI>;
        };
        mwj: mwj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LGUI &macro_tap &kp J &macro_release &kp LGUI>;
        };
        mwc: mwc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LGUI &macro_tap &kp C &macro_release &kp LGUI>;
        };
        m_mu: m_mu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &to 0 &macro_tap &kp INT_MUHENKAN>;
        };
        m_hn: m_hn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &to 0 &macro_tap &kp INT_HENKAN>;
        };
    };

    behaviors {
        tt: tt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&mo>, <&tog>;
        };
        ltm: ltm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&m_mu>;
        };
        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&m_hn>;
        };
        bth: bth {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&bt>, <&trans>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
    &kp Q              &kp W              &kp E              &kp R              &kp T              &kp Y              &kp U              &kp I              &kp O              &kp P
    &kp A              &kp S              &kp D              &kp F              &kp G              &bth BT_SEL_CMD 0  &out OUT_TOG  &kp H              &kp J              &kp K              &kp L              &kp ENTER
    &kp Z              &kp X              &kp C              &kp V              &kp B              &bth BT_SEL_CMD 1  &bth BT_CLR_ALL_CMD 0  &kp N              &kp M              &kp COMMA          &kp DOT            &kp MINUS
    &kp LCTRL          &lt 2 LGUI         &kp LALT           &kp LSHFT          &lt 3 BSPC         &lt 4 SPACE        &ltm 5 0           &lth 6 0           &kp INS
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
    &trans             &trans             &trans             &trans             &trans             &kp LC(M)          &kp LC(W)          &mwj               &kp LC(LS(TAB))    &kp LC(TAB)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &mwy               &mkp MB1           &mkp MB3           &mkp MB2           &kp ENTER
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LC(LS(N))      &mwc               &kp LC(C)          &kp LC(V)          &kp LG(E)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LC(SLASH)
            >;
        };

        win {
            display-name = "WIN";
            bindings = <
    &macro_0           &macro_1           &macro_2           &kp LA(F4)         &kp LC(LA(DEL))    &kp Y              &kp U              &kp I              &kp O              &kp P
    &kp LGUI           &kp LG(E)          &kp LG(R)          &trans             &kp LG(LC(LS(B)))  &trans             &trans             &kp H              &kp J              &kp K              &kp LG(L)          &kp ENTER
    &trans             &kp LG(X)          &trans             &trans             &kp LC(LA(PAUSE_BREAK))  &trans             &trans             &kp LCAPS          &kp LG(M)          &kp COMMA          &kp DOT            &kp MINUS
    &trans             &trans             &trans             &trans             &trans             &kp LG(SPACE)      &trans             &trans             &kp INS
            >;
        };

        symbol {
            display-name = "SYMBOL";
            bindings = <
    &kp LS(N1)         &kp LS(N2)         &kp LS(N3)         &kp LS(N4)         &kp LS(N5)         &kp LS(N6)         &kp LS(N7)         &kp LS(N8)         &kp LS(N9)         &kp LS(MINUS)
    &kp EQUAL          &kp PLUS           &kp LEFT_BRACE     &kp RIGHT_BRACE    &kp PIPE           &trans             &trans             &kp RIGHT_BRACKET  &kp BACKSLASH      &kp SEMICOLON      &kp SQT            &kp LEFT_BRACKET
    &kp LS(INT_YEN)    &trans             &trans             &kp LC(SEMICOLON)  &kp LC(SQT)        &trans             &trans             &kp LS(COMMA)      &kp LS(DOT)        &kp LS(SLASH)      &kp LS(INT_RO)     &kp INT_RO
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp SLASH
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
    &kp ESC            &trans             &trans             &kp LA(F11)        &kp GRAVE          &kp N7             &kp N8             &kp N9             &kp MINUS          &kp SLASH
    &kp TAB            &trans             &trans             &kp LALT           &kp LSHFT          &trans             &trans             &kp N4             &kp N5             &kp N6             &kp KP_PLUS        &kp KP_ENTER
    &kp LS(TAB)        &trans             &trans             &trans             &kp LCTRL          &trans             &trans             &kp N1             &kp N2             &kp N3             &kp DOT            &kp COMMA
    &trans             &trans             &trans             &kp LS(SPACE)      &trans             &trans             &trans             &kp N0             &kp KP_MULTIPLY
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
    &trans             &trans             &trans             &trans             &trans             &kp BSPC           &kp DEL            &kp INS            &kp HOME           &kp END
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LSHFT          &kp UP_ARROW       &kp LCTRL          &kp PG_UP          &kp ENTER
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LEFT_ARROW     &kp DOWN_ARROW     &kp RIGHT_ARROW    &kp PG_DN          &kp LS(LCTRL)
    &trans             &trans             &trans             &trans             &trans             &trans             &trans             &tt 4 4            &kp INS
            >;
        };

        func {
            display-name = "FUNC";
            bindings = <
    &kp F1             &kp F2             &kp F3             &kp F4             &kp F5             &kp Y              &kp U              &kp I              &kp LC(PG_UP)      &kp LC(PG_DN)
    &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &trans             &trans             &kp H              &kp J              &kp K              &kp L              &kp ENTER
    &kp F11            &kp F12            &kp LC(PAUSE_BREAK)  &kp PAUSE_BREAK    &kp PSCRN          &trans             &trans             &kp N              &kp M              &kp COMMA          &kp DOT            &kp MINUS
    &trans             &trans             &trans             &trans             &trans             &trans             &tt 3 3            &trans             &kp INS
            >;
        };
    };
};
